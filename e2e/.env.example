# Copiá este archivo a .env y ajustá si tu stack usa otras URLs/credenciales.
# Los defaults ya apuntan al stack Docker local (docker-compose.deploy.yml).

OPERATOR_URL=http://localhost:5173
PARTICIPANT_URL=http://localhost:5174
KEYCLOAK_URL=http://localhost:18090

# El front operador separa la UI por rol de forma EXCLUYENTE, así que el flujo
# completo necesita DOS identidades (ver env.ts):
#  - Administrador (crea/activa misiones) — usuario seed del realm.
ADMIN_USER=admin@umbral.local
ADMIN_PASSWORD=Umbral2026!
#  - Operador (gestiona sesiones en vivo) — el realm no trae ninguno, así que
#    global-setup lo aprovisiona por la Admin REST API de Keycloak.
OPERATOR_USER=operador.e2e@umbral.local
OPERATOR_PASSWORD=Umbral2026!

# Admin de Keycloak (realm master) para aprovisionar el operador. Coincide con
# docker-compose.yml (KEYCLOAK_ADMIN / KEYCLOAK_ADMIN_PASSWORD).
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=admin
KC_REALM=umbral

# APIs de dominio para sembrar la misión de prueba (controllers públicos).
MISSION_API=http://localhost:5091/api
STAGE_API=http://localhost:5093/api
CLUE_API=http://localhost:5094/api
