<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="FluentAssertions" Version="7.0.0" />
    <!-- HU-24: needed by RankingProjectorTests to spin up an in-memory TeamsDbContext. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.0" />
    <!-- Proxy: real IMemoryCache for CachedStageServiceProxyTests (Tests is a plain SDK,
         so it doesn't inherit the ASP.NET shared framework that ships this assembly). -->
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.5" />
  </ItemGroup>

  <!-- Correlation ID: los tests del middleware usan tipos de ASP.NET (DefaultHttpContext),
       que este SDK plano no trae por defecto. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MissionService\MissionService.csproj" />
    <ProjectReference Include="..\SessionService\SessionService.csproj" />
    <ProjectReference Include="..\StageService\StageService.csproj" />
    <ProjectReference Include="..\ClueService\ClueService.csproj" />
    <ProjectReference Include="..\TeamService\TeamService.csproj" />
    <ProjectReference Include="..\UserService\UserService.csproj" />
    <ProjectReference Include="..\Shared\UMBRAL.Observability\UMBRAL.Observability.csproj" />
  </ItemGroup>

</Project>
