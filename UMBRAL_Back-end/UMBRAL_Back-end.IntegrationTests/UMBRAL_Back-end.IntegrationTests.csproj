<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="FluentAssertions" Version="7.0.0" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.13.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MissionService\MissionService.csproj" />
    <!--
      Both MissionService and TeamService generate a top-level-statements `Program`
      class in the *global* namespace (RootNamespace does not affect it). Referencing
      both assemblies unqualified causes CS0433 ("Program exists in both..."). The
      Aliases metadata assigns TeamService's assembly to a named extern alias so
      TeamServiceApiFactory.cs can disambiguate via `extern alias TeamServiceAssembly;`.
      Any future service added here with its own Program class needs the same treatment.
    -->
    <ProjectReference Include="..\TeamService\TeamService.csproj">
      <Aliases>TeamServiceAssembly</Aliases>
    </ProjectReference>
    <!--
      ClueService also generates its own top-level-statements `Program` class in the
      global namespace, same conflict as TeamService above. Aliased the same way so
      ClueServiceApiFactory.cs can disambiguate via `extern alias ClueServiceAssembly;`.
    -->
    <ProjectReference Include="..\ClueService\ClueService.csproj">
      <Aliases>ClueServiceAssembly</Aliases>
    </ProjectReference>
    <!--
      StageService also generates its own top-level-statements `Program` class in the
      global namespace, same conflict as TeamService/ClueService above. Aliased the
      same way so StageServiceApiFactory.cs can disambiguate via
      `extern alias StageServiceAssembly;`.
    -->
    <ProjectReference Include="..\StageService\StageService.csproj">
      <Aliases>StageServiceAssembly</Aliases>
    </ProjectReference>
    <!--
      SessionService also generates its own top-level-statements `Program` class in the
      global namespace, same conflict as TeamService/ClueService/StageService above.
      Aliased the same way so SessionServiceApiFactory.cs can disambiguate via
      `extern alias SessionServiceAssembly;`.
    -->
    <ProjectReference Include="..\SessionService\SessionService.csproj">
      <Aliases>SessionServiceAssembly</Aliases>
    </ProjectReference>
  </ItemGroup>

</Project>
