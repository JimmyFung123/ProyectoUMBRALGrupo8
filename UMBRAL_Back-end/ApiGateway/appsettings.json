{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "Keycloak": {
    "Authority": "http://localhost:18090/realms/umbral",
    "RequireHttpsMetadata": false
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:5174"
    ]
  },
  "ReverseProxy": {
    "Routes": {
      "mission-route": {
        "ClusterId": "mission-cluster",
        "AuthorizationPolicy": "authenticated",
        "RateLimiterPolicy": "general",
        "Match": {
          "Path": "/mission-service/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "{**catch-all}" }
        ]
      },
      "stage-route": {
        "ClusterId": "stage-cluster",
        "AuthorizationPolicy": "authenticated",
        "RateLimiterPolicy": "general",
        "Match": {
          "Path": "/stage-service/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "{**catch-all}" }
        ]
      },
      "clue-route": {
        "ClusterId": "clue-cluster",
        "AuthorizationPolicy": "authenticated",
        "RateLimiterPolicy": "general",
        "Match": {
          "Path": "/clue-service/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "{**catch-all}" }
        ]
      },
      "session-route": {
        "ClusterId": "session-cluster",
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/session-service/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "{**catch-all}" }
        ]
      },
      "team-route": {
        "ClusterId": "team-cluster",
        "AuthorizationPolicy": "authenticated",
        "RateLimiterPolicy": "general",
        "Match": {
          "Path": "/team-service/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "{**catch-all}" }
        ]
      },
      "user-route": {
        "ClusterId": "user-cluster",
        "AuthorizationPolicy": "authenticated",
        "RateLimiterPolicy": "general",
        "Match": {
          "Path": "/user-service/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "{**catch-all}" }
        ]
      }
    },
    "Clusters": {
      "mission-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5091/"
          }
        }
      },
      "stage-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5093/"
          }
        }
      },
      "clue-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5094/"
          }
        }
      },
      "session-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5092/"
          }
        }
      },
      "team-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5095/"
          }
        }
      },
      "user-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5096/"
          }
        }
      }
    }
  }
}
