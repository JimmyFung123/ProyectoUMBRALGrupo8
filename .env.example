# UMBRAL — variables de despliegue (copiá este archivo a .env y completá).
# .env NO se commitea (está en .gitignore). docker-compose.deploy.yml lo lee.
#
# ── Local (probar el stack completo en tu PC, sin túnel) ─────────────────────
# Con dejar todo por defecto alcanza: el compose usa localhost/puertos dev.
#
# ── Secretos (cambialos siempre fuera de dev) ────────────────────────────────
POSTGRES_PASSWORD=12345
UMBRAL_BACKEND_SECRET=umbral-backend-secret-change-me

# ── Keycloak ─────────────────────────────────────────────────────────────────
# Authority = issuer que el navegador ve en los tokens. En LOCAL es localhost;
# en PROD es la URL pública del túnel (debe coincidir con KC_HOSTNAME).
KEYCLOAK_AUTHORITY=http://localhost:18090/realms/umbral
# MetadataAddress = de dónde bajan los servicios el JWKS (red interna de Docker).
KEYCLOAK_METADATA_ADDRESS=http://keycloak:8080/realms/umbral/.well-known/openid-configuration
# AdminBaseUrl = la Admin API que usa UserService (server-to-server, interno).
KEYCLOAK_ADMIN_BASE_URL=http://keycloak:8080
# En PROD (Keycloak por HTTPS) poné true.
KEYCLOAK_REQUIRE_HTTPS=false

# ── CORS: orígenes de los fronts que llaman a las APIs ───────────────────────
CORS_OPERADOR_ORIGIN=http://localhost:5173
CORS_PARTICIPANTE_ORIGIN=http://localhost:5174

# ── SMTP (correo de alta de usuario — HU-23) ─────────────────────────────────
# LOCAL: Mailpit (captura, no envía). PROD: SMTP real (SendGrid/SES/Gmail).
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM_ADDRESS=no-reply@umbral.local
SMTP_FROM_NAME=UMBRAL — Personal Operativo
SMTP_USE_STARTTLS=false
SMTP_USER=
SMTP_PASSWORD=

# ── URLs públicas (build de los fronts + hostname de Keycloak) ───────────────
# En LOCAL podés dejarlas por defecto. En PROD = tus hostnames del túnel
# Cloudflare. OJO: los fronts hornean estas URLs en build → al cambiarlas hay
# que reconstruir las imágenes (docker compose ... build).
PUBLIC_KEYCLOAK_URL=http://localhost:18090
PUBLIC_MISSION_API_URL=http://localhost:5091/api
PUBLIC_SESSION_API_URL=http://localhost:5092/api
PUBLIC_SESSION_SIGNALR_URL=http://localhost:5092/hubs/session
PUBLIC_STAGE_API_URL=http://localhost:5093/api
PUBLIC_CLUE_API_URL=http://localhost:5094/api
PUBLIC_TEAM_API_URL=http://localhost:5095/api
PUBLIC_USER_API_URL=http://localhost:5096/api

# ── Túnel Cloudflare (solo si usás --profile tunnel) ─────────────────────────
# Token del túnel con nombre (Cloudflare Zero Trust → Tunnels → tu túnel).
CLOUDFLARE_TUNNEL_TOKEN=
